# Backend environment variables. Every one has a local default in
# backend/src/main/resources/application.yml; set them for any shared or production deployment.

# JDBC form is required (not postgresql://). Neon needs sslmode=require.
DB_URL=jdbc:postgresql://localhost:5433/pollenz
DB_USER=pollenz
DB_PASSWORD=change-me

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes

# Exact origin of the deployed frontend: scheme + host, no path, no trailing slash.
# Used for CORS and for the WebSocket handshake.
CORS_ORIGIN=http://localhost:5173

# Set by the hosting platform (Render). Defaults to 8080.
# PORT=8080
