# Copy to .env.local for local overrides. Both are optional in development:
# the Vite dev server proxies /api and /ws to http://localhost:8080.

# Base URL of the REST API, including the /api prefix. Default: /api
VITE_API_URL=https://your-api.onrender.com/api

# Full WebSocket URL of the STOMP endpoint. Default: same host, /ws
VITE_WS_URL=wss://your-api.onrender.com/ws
